# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials.
# The .env file is strictly ignored by .gitignore and will never be committed.
# ==============================================================================

# Looker Instance & Credentials
LOOKER_BASE_URL="https://<YOUR_LOOKER_INSTANCE>.looker.app"
LOOKER_CLIENT_ID="<YOUR_LOOKER_CLIENT_ID>"
LOOKER_CLIENT_SECRET="<YOUR_LOOKER_CLIENT_SECRET>"

# Looker Python SDK format
LOOKERSDK_BASE_URL="https://<YOUR_LOOKER_INSTANCE>.looker.app"
LOOKERSDK_CLIENT_ID="<YOUR_LOOKER_CLIENT_ID>"
LOOKERSDK_CLIENT_SECRET="<YOUR_LOOKER_CLIENT_SECRET>"

# Google Cloud Profile Configuration
CLOUDSDK_ACTIVE_CONFIG_NAME="default"
GCP_DEFAULT_ACCOUNT="user@example.com"
GCP_PROJECT_ID="your-gcp-project-id"
